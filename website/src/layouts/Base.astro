---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { product, links } from "../data/product";
import { withBase } from "../lib/paths";
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  path?: string;
  ogType?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogType = "website",
  jsonLd: jsonLdOverride
} = Astro.props;
const canonical = new URL(path, Astro.site);
const ogImage = new URL(withBase("og.png"), Astro.site);
const pageTitle = title.includes(product.name) ? title : `${title} · ${product.name}`;
// Every page carries the same site, maker, and app nodes (linked by @id) plus its own page nodes.
const home = new URL(withBase("/"), Astro.site).toString();
const siteGraph = [
  {
    "@type": "Organization",
    "@id": `${home}#org`,
    name: product.maker,
    url: links.neuralaxis,
    logo: new URL(withBase("logo-icon.png"), Astro.site).toString()
  },
  {
    "@type": "WebSite",
    "@id": `${home}#website`,
    name: product.name,
    url: home,
    publisher: { "@id": `${home}#org` }
  },
  {
    "@type": "SoftwareApplication",
    "@id": `${home}#app`,
    name: product.name,
    description: product.seoDescription,
    url: home,
    applicationCategory: "DeveloperApplication",
    applicationSubCategory: "Code security and quality scanner",
    operatingSystem: "Windows, macOS, Linux",
    softwareRequirements: `Node.js ${product.node}`,
    softwareVersion: product.version,
    license: "https://www.gnu.org/licenses/gpl-3.0.html",
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    downloadUrl: links.npm,
    image: ogImage.toString(),
    featureList: product.features,
    keywords: product.keywords.join(", "),
    author: { "@id": `${home}#org` },
    publisher: { "@id": `${home}#org` },
    sameAs: [links.github, links.npm]
  }
];
const ownNodes = jsonLdOverride
  ? (Array.isArray(jsonLdOverride) ? jsonLdOverride : [jsonLdOverride]).flatMap((node) =>
      Array.isArray(node["@graph"]) ? (node["@graph"] as Record<string, unknown>[]) : [node]
    )
  : [
      {
        "@type": "WebPage",
        name: pageTitle,
        description,
        url: canonical.toString(),
        isPartOf: { "@id": `${home}#website` },
        about: { "@id": `${home}#app` }
      }
    ];
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [...siteGraph, ...ownNodes.map(({ "@context": _context, ...node }) => node)]
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F5F3ED" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase("favicon-32.png")} type="image/png" sizes="32x32" />
    <link rel="icon" href={withBase("favicon-48.png")} type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} sizes="180x180" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={product.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="site-frame">
      <span class="crop-bl" aria-hidden="true"></span>
      <span class="crop-br" aria-hidden="true"></span>
      <Header />
      <main id="content">
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      function bindCopy(root: ParentNode = document) {
        root.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((button) => {
          if (button.dataset.bound === "1") return;
          button.dataset.bound = "1";
          button.addEventListener("click", async () => {
            const value = button.dataset.copy ?? "";
            try {
              await navigator.clipboard.writeText(value);
              button.dataset.copied = "true";
              button.textContent = "Copied";
            } catch {
              button.textContent = "Select + copy";
            }
            window.setTimeout(() => {
              button.dataset.copied = "false";
              button.textContent = "Copy";
            }, 1600);
          });
        });
      }
      bindCopy();
    </script>
  </body>
</html>
