---
import Base from "../layouts/Base.astro";
import Command from "../components/Command.astro";
import {
  product,
  commands,
  languages,
  specimen,
  links
} from "../data/product";
import { withBase } from "../lib/paths";
---

<Base
  title={`${product.name} · Deterministic code-health analysis`}
  description="VibeDoctor is a local, deterministic code-health system for JavaScript, TypeScript, Python, and mixed repositories. Evidence-backed findings for humans and coding agents."
  path={withBase("/")}
>
  <div class="site-wrap folio">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="kicker">
          <span>00 / Diagnosis</span>
          <span>Doc VD-WEB · v{product.version}</span>
        </p>
        <h1 id="hero-title">
          <span>Your code has</span>
          <span>an opinionated</span>
          <span>second opinion.</span>
        </h1>
        <p class="lede">
          Deterministic code-health analysis for software written by humans and AI.
          No vibes about the diagnosis.
        </p>
        <Command command={commands.scanFull} />
        <p class="note">
          Full-repository scan. Local by default. Missing scanners are incomplete
          evidence, never a silent pass.
        </p>
      </div>

      <aside class="specimen" aria-label="Specimen diagnosis from a test fixture">
        <div class="specimen-bar">
          <span>Current diagnosis</span>
          <span>{specimen.label}</span>
        </div>
        <div class="specimen-stats">
          <div class="stat">
            <div class="stat-label">Health</div>
            <div class="stat-value warn">{specimen.health}</div>
          </div>
          <div class="stat">
            <div class="stat-label">Completeness</div>
            <div class="stat-value warn">{specimen.completeness}</div>
          </div>
          <div class="stat">
            <div class="stat-label">Blockers</div>
            <div class="stat-value bad">{String(specimen.blockers).padStart(2, "0")}</div>
          </div>
          <div class="stat">
            <div class="stat-label">Fix next</div>
            <div class="stat-value">{String(specimen.fixNext).padStart(2, "0")}</div>
          </div>
        </div>
        <div class="finding">
          <div class="finding-id">Finding / {specimen.findingId}</div>
          <p class="finding-title">{specimen.title}</p>
          <dl class="kv">
            <dt>Severity</dt>
            <dd>{specimen.severity}</dd>
            <dt>Confidence</dt>
            <dd>{specimen.confidence}</dd>
            <dt>Category</dt>
            <dd>{specimen.category}</dd>
            <dt>Source</dt>
            <dd>{specimen.source}</dd>
            <dt>Location</dt>
            <dd>{specimen.file}:{specimen.startLine}</dd>
          </dl>
          <pre class="snippet"><code>{specimen.snippet}</code></pre>
        </div>
      </aside>
    </section>

    <section class="section" id="problem" aria-labelledby="problem-title">
      <div class="section-head split">
        <div>
          <p class="section-id">01 / The problem</p>
          <h2 id="problem-title">A passing build does not mean healthy code.</h2>
        </div>
        <div class="prose">
          <p>
            AI writes faster than humans can review. Inherited repositories hide decay
            that compilation never sees: leftover flags, isolated files, committed
            credentials, personal-data fields, and unused exports.
          </p>
          <p>
            {product.name} is a local health check for code you did not write line by line.
            One ranked report. One finding format. A fix-next plan a person or an agent
            can follow.
          </p>
        </div>
      </div>
      <div class="compare">
        <article>
          <p class="kicker"><span>Build passed</span><span>What it proves</span></p>
          <h3>The compiler and tests finished.</h3>
          <ul>
            <li>Types may check. Suites may be green.</li>
            <li>A secret in config still compiles.</li>
            <li>Dead files do not fail the build.</li>
            <li>A leftover <code>LEGACY_AUTH_ENABLED</code> branch is still “working code.”</li>
          </ul>
        </article>
        <article>
          <p class="kicker"><span>{product.name}</span><span>What it adds</span></p>
          <h3>Evidence, location, and a next action.</h3>
          <ul>
            <li>Normalized findings with IDs, severity, and confidence.</li>
            <li>A coverage table so “installed” is not confused with “completed.”</li>
            <li>COMPLETE / PARTIAL / INVALID — skipped tools are never clean.</li>
            <li>An ordered repair plan for a person or a coding agent.</li>
          </ul>
        </article>
      </div>
    </section>

    <section class="section" id="specimen" aria-labelledby="specimen-title">
      <div class="section-head split">
        <div>
          <p class="section-id">02 / Sample diagnosis</p>
          <h2 id="specimen-title">Show the evidence, not the adjective.</h2>
        </div>
        <div class="prose">
          <p>
            This specimen is taken from the project’s own test fixture
            <span class="mono">fixtures/broken-security/src/config.ts</span>
            and the snapshot report. Same tree, same finding ID.
          </p>
        </div>
      </div>
      <div class="compare">
        <article>
          <dl class="kv">
            <dt>Finding</dt>
            <dd class="mono">{specimen.findingId}</dd>
            <dt>Severity</dt>
            <dd>{specimen.severity}</dd>
            <dt>Confidence</dt>
            <dd>{specimen.confidence}</dd>
            <dt>Category</dt>
            <dd>{specimen.category}</dd>
            <dt>Rule / source</dt>
            <dd>{specimen.source}</dd>
            <dt>Location</dt>
            <dd>{specimen.file}:{specimen.startLine}</dd>
          </dl>
        </article>
        <article class="stack">
          <div>
            <p class="kicker"><span>Why</span></p>
            <p>{specimen.why}</p>
          </div>
          <div>
            <p class="kicker"><span>Evidence</span></p>
            <ul>
              {specimen.evidence.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <div>
            <p class="kicker"><span>Prescription</span></p>
            <p>{specimen.prescription}</p>
          </div>
          <p class="note">{specimen.note}</p>
        </article>
      </div>
    </section>

    <section class="section" id="looks-for" aria-labelledby="looks-title">
      <div class="section-head split">
        <div>
          <p class="section-id">03 / What a full scan covers</p>
          <h2 id="looks-title">The report you get from one command.</h2>
        </div>
        <div class="prose">
          <p>
            Languages: {languages.join(" · ")}. The engine detects the repository
            and runs the applicable local tools. Built-in detectors cover leftovers,
            dead chains, refactor-readiness, and privacy even when no extra binary
            is installed.
          </p>
          <p>
            Secrets, types, lint, tests, unused code, vulnerable dependencies,
            complexity, and personal-data signals land in one ranked list — with a
            completeness grade so a skipped scanner cannot look like a clean bill
            of health.
          </p>
          <p>
            <a href={withBase("/how-it-works/")}>How scoring and the tool matrix work →</a>
          </p>
        </div>
      </div>
    </section>

    <section class="section" id="install" aria-labelledby="install-title">
      <div class="section-head split">
        <div>
          <p class="section-id">04 / Run it</p>
          <h2 id="install-title">This is the command.</h2>
        </div>
        <div class="prose">
          <p>Requires Node.js {product.node}. Package {product.package}@{product.version}.</p>
        </div>
      </div>
      <div class="stack">
        <Command command={commands.scanFull} />
        <p>
          That is a full-repository diagnosis. After you have a baseline, use
          <code>verify</code> or <code>scan --changed</code> for later edits —
          those modes are documented on
          <a href={withBase("/how-it-works/")}>How it works</a>.
        </p>
        <p>First time on a machine, install the recommended scanners, then scan again:</p>
        <pre><code>{`npx @neuralaxis/vibedoctor init
npx @neuralaxis/vibedoctor setup
npx @neuralaxis/vibedoctor setup --apply
npx @neuralaxis/vibedoctor scan --full`}</code></pre>
        <p class="note">
          <code>setup --apply</code> installs supported recommended tools. Review the
          plan first. Global binary: <code>{commands.globalInstall}</code>
        </p>
        <p>
          After the report:
          <a href={withBase("/agents/")}>hand it to an agent</a>
          {" · "}
          <a href={withBase("/privacy/")}>what stays on the machine</a>
          {" · "}
          <a href={withBase("/articles/")}>pre-ship checklists</a>
        </p>
        <p>
          <a href={links.github} rel="noreferrer">GitHub</a>
          {" · "}
          <a href={links.npm} rel="noreferrer">npm</a>
        </p>
      </div>
    </section>
  </div>
</Base>
