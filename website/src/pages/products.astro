---
import Base from "../layouts/Base.astro";
import { links, product } from "../data/product";
import { withBase } from "../lib/paths";
---

<Base
  title="Products"
  description="NeuralAxis ships VibeDoctor and Benki. This page lists live products only."
  path={withBase("/products/")}
>
  <div class="site-wrap folio">
    <header class="page-hero">
      <div>
        <p class="section-id">Products</p>
        <h1>Shipped products.</h1>
      </div>
      <p class="lede">
        {product.name} is the product this site exists for. Benki has its own site.
        Nothing else is listed until it ships.
      </p>
    </header>

    <div class="products" style="margin-top:0.5rem">
      <a class="product" href={withBase("/")}>
        <p class="kicker"><span>01</span><span>This site</span></p>
        <h3>VibeDoctor</h3>
        <p class="note">
          Deterministic code-health analysis for JavaScript, TypeScript, Python,
          and mixed repositories. CLI, agent pack, MCP.
        </p>
        <p class="note" style="margin-top:0.6rem">{product.package}</p>
      </a>
      <a class="product" href={links.benki} rel="noreferrer">
        <p class="kicker"><span>External</span><span>benki.tech</span></p>
        <h3>Benki</h3>
        <p class="note">
          A separate NeuralAxis product. Details live on benki.tech, not here.
        </p>
      </a>
    </div>

    <section class="section">
      <p class="section-id">Maker</p>
      <p>
        Both are NeuralAxis products.
        <a href={links.neuralaxis} rel="noreferrer">neuralaxis.ai</a>
        {" · "}
        <a href={withBase("/company/")}>Company</a>
      </p>
    </section>
  </div>
</Base>
