---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Command from "../../components/Command.astro";
import { commands } from "../../data/product";
import { withBase } from "../../lib/paths";
import { fileNumber, sortArticles, stageMeta, stages } from "../../lib/articles";

const published = sortArticles(await getCollection("articles", ({ data }) => !data.draft));
const lead = published.find((post) => post.data.rank === 1) ?? published[0];
const startHere = stages
  .map((stage) => {
    const first = published.find((post) => post.data.stage === stage.id);
    return first ? { stage, post: first } : null;
  })
  .filter((entry): entry is { stage: (typeof stages)[number]; post: (typeof published)[number] } =>
    Boolean(entry)
  );
---

<Base
  title="Articles"
  description="A small pre-launch library for vibe-coded apps: security checklists for Lovable, Bolt.new, Cursor, and Supabase, plus how to test an AI-generated app before it is public."
  path={withBase("/articles/")}
>
  <div class="site-wrap folio article-index">
    <header class="page-hero article-index-hero">
      <div>
        <p class="section-id">Articles · {String(published.length).padStart(2, "0")} filed</p>
        <h1>Notes for the hour before you ship.</h1>
      </div>
      <div class="article-index-lede">
        <p class="lede">
          Checklists for the hour before you point a domain at an AI-built app.
          Open one note, then scan the exported repository. Do not collect the
          whole library first.
        </p>
        <Command command={commands.scanFull} />
      </div>
    </header>

    {
      published.length === 0 ? (
        <div class="empty-index">
          <p class="kicker">
            <span>Queue</span>
            <span>0 filed</span>
          </p>
          <h2 style="margin:0.6rem 0 0.45rem">No articles published.</h2>
          <p class="note">
            An empty index is more honest than a placeholder essay. When there is a finding worth
            writing down, drop a <code>.md</code> file in
            <code>website/src/content/articles/</code> with <code>title</code>,
            <code>description</code>, and <code>pubDate</code>.
          </p>
        </div>
      ) : (
        <>
          {lead && (
            <section class="section article-lead-section" aria-labelledby="lead-title">
              <p class="section-id">Open first · File {fileNumber(lead)}</p>
              <a class="article-lead" href={withBase(`/articles/${lead.id}/`)}>
                <div>
                  <p class="article-lead-kicker">
                    {stageMeta(lead.data.stage)?.label ?? "Note"} · if you are shipping tonight
                  </p>
                  <h2 id="lead-title">{lead.data.title}</h2>
                  <p>{lead.data.description}</p>
                </div>
                <span class="article-lead-go">Read the note →</span>
              </a>
            </section>
          )}

          <nav class="article-start" aria-labelledby="start-title">
            <div class="section-head">
              <div>
                <p class="section-id">Path</p>
                <h2 id="start-title">Three ways in.</h2>
              </div>
            </div>
            <ol class="article-start-grid">
              {startHere.map(({ stage, post }) => (
                <li>
                  <a href={`#stage-${stage.id}`}>
                    <span class="article-start-id">{stage.numeral} / {stage.label}</span>
                    <strong>{stage.title}</strong>
                    <span class="article-start-file">Start with file {fileNumber(post)}</span>
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          {stages.map((stage) => {
            const rows = published.filter((post) => post.data.stage === stage.id);
            if (rows.length === 0) return null;
            return (
              <section class="section article-stage" id={`stage-${stage.id}`} aria-labelledby={`${stage.id}-title`}>
                <div class="section-head split">
                  <div>
                    <p class="section-id">{stage.numeral} / {stage.label}</p>
                    <h2 id={`${stage.id}-title`}>{stage.title}</h2>
                  </div>
                  <p class="prose">{stage.body}</p>
                </div>
                <ol class="article-docket">
                  {rows.map((post) => (
                    <li>
                      <a class="article-row" href={withBase(`/articles/${post.id}/`)}>
                        <span class="article-row-no" aria-hidden="true">{fileNumber(post)}</span>
                        <span class="article-row-copy">
                          <span class="article-row-title">{post.data.title}</span>
                          <span class="article-row-summary">{post.data.description}</span>
                        </span>
                        <span class="article-row-go" aria-hidden="true">Open</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </section>
            );
          })}
        </>
      )
    }
  </div>
</Base>
