---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Command from "../../components/Command.astro";
import { product, commands } from "../../data/product";
import { checksForArticle } from "../../data/checks";
import { withBase } from "../../lib/paths";
import {
  fileNumber,
  formatFiled,
  neighbors,
  readingMinutes,
  sortArticles,
  stageMeta
} from "../../lib/articles";

export async function getStaticPaths() {
  const published = await getCollection("articles", ({ data }) => !data.draft);
  return published.map((post) => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const published = sortArticles(await getCollection("articles", ({ data }) => !data.draft));
const related = post.data.related
  .map((id) => published.find((entry) => entry.id === id))
  .filter((entry): entry is (typeof published)[number] => Boolean(entry));
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const stage = stageMeta(post.data.stage);
const minutes = readingMinutes(post.body ?? post.data.description);
const { prev, next } = neighbors(published, post.id);
const filed = formatFiled(post.data.pubDate);
const catching = checksForArticle(post.id);

const canonicalPath = withBase(`/articles/${post.id}/`);
const canonical = new URL(canonicalPath, Astro.site);
const date = post.data.pubDate.toISOString();
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: post.data.title,
      description: post.data.description,
      datePublished: date,
      dateModified: date,
      timeRequired: `PT${minutes}M`,
      mainEntityOfPage: canonical.toString(),
      author: {
        "@type": "Organization",
        name: product.maker,
        url: "https://neuralaxis.ai"
      },
      image: new URL(withBase("og.png"), Astro.site).toString(),
      publisher: {
        "@type": "Organization",
        name: product.name,
        url: new URL(withBase("/"), Astro.site).toString(),
        logo: {
          "@type": "ImageObject",
          url: new URL(withBase("logo-lockup.png"), Astro.site).toString()
        }
      }
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: product.name,
          item: new URL(withBase("/"), Astro.site).toString()
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Articles",
          item: new URL(withBase("/articles/"), Astro.site).toString()
        },
        {
          "@type": "ListItem",
          position: 3,
          name: post.data.title,
          item: canonical.toString()
        }
      ]
    }
  ]
};
---

<Base
  title={post.data.title}
  description={post.data.description}
  path={canonicalPath}
  ogType="article"
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={date} />
    <meta property="article:modified_time" content={date} />
  </Fragment>
  <div class="read-progress" aria-hidden="true">
    <span id="read-progress-bar"></span>
  </div>
  <article class="site-wrap folio article-page">
    <header class="article-mast">
      <nav class="article-crumbs" aria-label="Breadcrumb">
        <a href={withBase("/articles/")}>Articles</a>
        {
          stage && (
            <>
              <span aria-hidden="true">/</span>
              <a href={withBase(`/articles/#stage-${stage.id}`)}>{stage.label}</a>
            </>
          )
        }
        <span aria-hidden="true">/</span>
        <span>File {fileNumber(post)}</span>
      </nav>
      <p class="section-id">
        {stage ? `${stage.numeral} / ${stage.label}` : "Note"}
      </p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <dl class="article-meta">
        <div>
          <dt>Filed</dt>
          <dd><time datetime={date}>{filed}</time></dd>
        </div>
        <div>
          <dt>Read</dt>
          <dd>{minutes} min</dd>
        </div>
        <div>
          <dt>Library</dt>
          <dd>{fileNumber(post)} of {String(published.length).padStart(2, "0")}</dd>
        </div>
      </dl>
    </header>

    <div class="article-layout">
      {
        toc.length > 1 && (
          <nav class="article-toc" aria-labelledby="toc-title">
            <details class="toc-fold">
              <summary id="toc-title">On this page</summary>
              <ol>
                {toc.map((heading) => (
                  <li class:list={{ "is-h3": heading.depth === 3 }}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </nav>
        )
      }
      <div class="section prose article-body">
        <Content />
      </div>
    </div>

    <aside class="article-cta" aria-labelledby="article-cta-title">
      <p class="section-id">Prescription</p>
      <h2 id="article-cta-title">Run the local check on the repo you are about to ship.</h2>
      <p>
        {product.name} is a local health check for JavaScript, TypeScript, Python, and mixed
        repositories. It will not replace a human abuse-case pass. It will tell you whether
        secrets, vulnerable dependencies, leftover “skip auth” comments, and incomplete scanners
        are still sitting in the tree.
      </p>
      <Command command={commands.scanFull} />
      {
        catching.length > 0 && (
          <ul class="check-links">
            {catching.map((check) => (
              <li>
                <a href={withBase(`/checks/${check.slug}/`)}>
                  <strong>{check.name}</strong>
                  <span>{check.teaser}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
      <p class="note">
        Run that before opening another note.
        <a href={withBase("/how-it-works/")}>How a scan is scored</a>
        {" · "}
        <a href={withBase("/agents/")}>Hand the report to an agent</a>
      </p>
    </aside>

    {
      related.length > 0 && (
        <nav class="article-related" aria-labelledby="related-title">
          <p class="section-id">Also filed</p>
          <h2 id="related-title">Keep going if this note was not enough.</h2>
          <ol class="article-docket article-docket-compact">
            {related.map((entry) => (
              <li>
                <a class="article-row" href={withBase(`/articles/${entry.id}/`)}>
                  <span class="article-row-no" aria-hidden="true">{fileNumber(entry)}</span>
                  <span class="article-row-copy">
                    <span class="article-row-title">{entry.data.title}</span>
                    <span class="article-row-summary">{entry.data.description}</span>
                  </span>
                  <span class="article-row-go" aria-hidden="true">Open</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <nav class="article-folio-nav" aria-label="Library sequence">
      {
        prev ? (
          <a class="folio-step is-prev" href={withBase(`/articles/${prev.id}/`)}>
            <span>Previous · {fileNumber(prev)}</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : (
          <span class="folio-step is-empty"></span>
        )
      }
      <a class="folio-index" href={withBase("/articles/")}>All notes</a>
      {
        next ? (
          <a class="folio-step is-next" href={withBase(`/articles/${next.id}/`)}>
            <span>Next · {fileNumber(next)}</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : (
          <span class="folio-step is-empty"></span>
        )
      }
    </nav>
  </article>
  <script>
    const bar = document.getElementById("read-progress-bar");
    const body = document.querySelector(".article-body");
    const fold = document.querySelector<HTMLDetailsElement>(".toc-fold");
    const wide = window.matchMedia("(min-width: 980px)");
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".article-toc a"));

    const syncToc = () => {
      if (fold) fold.open = wide.matches;
    };
    syncToc();
    wide.addEventListener("change", syncToc);

    function setProgress() {
      if (!bar || !body) return;
      const rect = body.getBoundingClientRect();
      const start = window.scrollY + rect.top - 96;
      const span = Math.max(rect.height - window.innerHeight * 0.45, 1);
      const value = Math.min(1, Math.max(0, (window.scrollY - start) / span));
      bar.style.transform = `scaleX(${value})`;
    }

    function setActive() {
      if (links.length === 0) return;
      const offset = 120;
      let current = links[0];
      for (const link of links) {
        const id = decodeURIComponent(link.hash.slice(1));
        const target = document.getElementById(id);
        if (!target) continue;
        if (target.getBoundingClientRect().top - offset <= 0) current = link;
      }
      links.forEach((link) => link.toggleAttribute("aria-current", link === current));
    }

    const onScroll = () => {
      setProgress();
      setActive();
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  </script>
</Base>
