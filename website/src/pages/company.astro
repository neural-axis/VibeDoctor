---
import Base from "../layouts/Base.astro";
import { links, product } from "../data/product";
import { withBase } from "../lib/paths";
---

<Base
  title="Company"
  description="VibeDoctor is a NeuralAxis product. This page points at neuralaxis.ai."
  path={withBase("/company/")}
>
  <div class="site-wrap folio">
    <header class="page-hero">
      <div>
        <p class="section-id">Company</p>
        <h1>NeuralAxis makes {product.name}.</h1>
      </div>
      <p class="lede">
        Use this site to run the product. Company narrative lives at
        <a href={links.neuralaxis} rel="noreferrer">neuralaxis.ai</a>.
      </p>
    </header>

    <section class="section">
      <div class="compare">
        <article>
          <p class="kicker"><span>Product</span></p>
          <img
            class="footer-mark"
            src={withBase("logo-portrait.png")}
            alt={product.name}
            width="220"
            height="161"
            style="margin-bottom:0.7rem"
          />
          <h3>{product.name}</h3>
          <p class="note">
            Deterministic code-health system. CLI, reports, agent pack, MCP.
            You are on the product site.
          </p>
          <p style="margin-top:0.85rem">
            <a href={withBase("/#install")}>Run a full scan →</a>
          </p>
        </article>
        <article>
          <p class="kicker"><span>Maker</span></p>
          <h3>NeuralAxis</h3>
          <p class="note">
            The organisation that builds {product.name} and
            <a href={links.benki} rel="noreferrer">Benki</a>.
            Continue at
            <a href={links.neuralaxis} rel="noreferrer">neuralaxis.ai</a>.
          </p>
        </article>
      </div>
    </section>
  </div>
</Base>
